# SecurePay — Variables d'environnement (template)
# Copier en .env — JAMAIS committer .env

POSTGRES_PASSWORD=securepay_dev
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_PASSWORD=keycloak_dev
RABBITMQ_PASSWORD=securepay_dev
GRAFANA_PASSWORD=admin
VAULT_DEV_ROOT_TOKEN=lab-root-token
WEBHOOK_SECRET=lab-webhook-secret-change-me

DATABASE_URL=postgresql+asyncpg://securepay:securepay_dev@localhost:5433/securepay
REDIS_URL=redis://localhost:6380/0
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=securepay
KEYCLOAK_CLIENT_ID=securepay-gateway

# AES-256-GCM 32 bytes hex — en prod: vault kv get secret/securepay/encryption
VAULT_MASTER_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
APP_ENV=lab

FRAUD_THRESHOLD=0.85
RATE_LIMIT_PER_MINUTE=60
SECUREPAY_EVENT_LOG=logs/securepay-events.jsonl

# Core COBOL (activé automatiquement avec docker compose --profile app)
LEGACY_CORE_URL=
LEGACY_CORE_TIMEOUT=2.5

# EMV 3DS 2.3.1 — secret partagé HMAC entre gateway/3DSS/DS/ACS
THREEDS_SECRET=lab-3ds-secret-change-me
THREEDS_SERVER_URL=http://localhost:8020
DIRECTORY_SERVER_URL=http://localhost:8021
ACS_SERVER_URL=http://localhost:8022

# OpenTelemetry — exporter OTLP optionnel (vide = fallback JSONL local)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Charge de travail pour le benchmark fraude (docs/SECURITY_METRICS.md)
FRAUD_BENCHMARK_SIZE=2000
