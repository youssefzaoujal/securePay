{
  "id": null,
  "title": "SecurePay — Transaction, Fraud, Latency",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "type": "stat",
      "title": "Transactions (total)",
      "id": 1,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(securepay_transactions_total)", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "Alertes Sigma",
      "id": 2,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "sum(securepay_detection_alerts_total)", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Score de fraude (p95)",
      "id": 3,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(securepay_fraud_score_bucket[5m])) by (le))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "min": 0, "max": 1 }
      }
    },
    {
      "type": "timeseries",
      "title": "Latence HTTP (p95, secondes)",
      "id": 4,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(securepay_request_latency_seconds_bucket[5m])) by (le, service))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    }
  ]
}
